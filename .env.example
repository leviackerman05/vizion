# Local development. Never commit .env or print real credentials.
ENVIRONMENT=development
PUBLIC_URL=http://localhost:8080
DATABASE_URL=sqlite:///./data/vizion.db
DATA_DIR=data
APP_ROLE=web
EMBEDDED_WORKER=false
# Only the worker needs this key. The built-in example needs no model API.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Windows development uses its installed voice. Railway uses offline Piper.
TTS_PROVIDER=auto
PIPER_MODEL=/opt/piper/en_US-ljspeech-high.onnx
RENDER_HEIGHT=720
RENDER_FPS=24
# Production requires PostgreSQL, HTTPS, and private S3-compatible storage.
# Railway DATABASE_URL reference: ${{Postgres.DATABASE_URL}}
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto
S3_ADDRESSING_STYLE=virtual
DAILY_PROJECT_LIMIT=5
DAILY_RENDER_LIMIT=3
GLOBAL_DAILY_RENDER_LIMIT=10
MAX_PENDING_JOBS=12
